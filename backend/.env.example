# HTTP server
HOST=127.0.0.1
PORT=8787

# Optional database path; defaults to backend/data/db.json
JSON_DB_PATH=/absolute/path/to/db.json

# Optional fixed password. When omitted, the existing MMDD password rule is used.
JSON_DB_LOGIN_PASSWORD=change-me

# Public origin used when turning supplemental URLs into /a–/d short links.
PUBLIC_BASE_URL=https://design.example.com

# Google Sign-In verification (the current front-end client ID is used by default).
GOOGLE_OAUTH_CLIENT_ID=501170620928-dh3e431763b4ah8crq7kirmsu8m17bdj.apps.googleusercontent.com
