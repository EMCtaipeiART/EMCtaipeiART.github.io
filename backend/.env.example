# HTTP server
HOST=127.0.0.1
PORT=8787

# Optional database path; defaults to backend/data/db.json
JSON_DB_PATH=/absolute/path/to/db.json

# Optional fixed password. When omitted, the existing MMDD password rule is used.
JSON_DB_LOGIN_PASSWORD=change-me

# Public origin used when turning supplemental URLs into /a–/d short links.
PUBLIC_BASE_URL=https://design.example.com

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=https://emctaipeiart.github.io,http://127.0.0.1:8787,http://localhost:8787

# Optional persistent upload directory; defaults to backend/media/uploads.
MEDIA_ROOT=/absolute/path/to/persistent/media/uploads

# Google Sign-In verification (the current front-end client ID is used by default).
GOOGLE_OAUTH_CLIENT_ID=501170620928-dh3e431763b4ah8crq7kirmsu8m17bdj.apps.googleusercontent.com

# ERP OAuth 2.0 + PKCE. Keep the client secret on the server only.
ERP_BASE_URL=https://manage.emctaipei.com
ERP_CLIENT_ID=replace-with-erp-client-id
ERP_CLIENT_SECRET=replace-with-erp-client-secret
ERP_REDIRECT_URI=https://emctaipeiart.github.io/
