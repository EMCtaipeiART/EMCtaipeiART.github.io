{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "machi-design-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "go.emc-art.com", "custom_domain": true },
    { "pattern": "emc-art.com/*", "zone_name": "emc-art.com" }
  ],
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://emctaipeiart.github.io,https://emc-art.com,https://go.emc-art.com,http://127.0.0.1:8787,http://localhost:8787",
    "GITHUB_OWNER": "EMCtaipeiART",
    "GITHUB_REPO": "EMCtaipeiART.github.io",
    "GITHUB_BRANCH": "main",
    "GITHUB_DATABASE_PATH": "backend/data/db.json",
    "GOOGLE_OAUTH_CLIENT_ID": "501170620928-dh3e431763b4ah8crq7kirmsu8m17bdj.apps.googleusercontent.com",
    "GMAIL_OAUTH_CLIENT_ID": "910684492076-ehgnu9u5sbgir0lm6pscdlaj0vgcsrpu.apps.googleusercontent.com",
    "ERP_BASE_URL": "https://manage.emctaipei.com",
    "ERP_CLIENT_ID": "oauth_n3gUqm5r84Mu",
    "ERP_REDIRECT_URI": "https://emc-art.com",
    "ADMIN_LOGIN_ACCOUNTS": "machi.chen@emctaipei.com",
    "SESSION_TTL_SECONDS": "2592000",
    "UPLOAD_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzgK-0G-MQ1xk3veoI19aFWgkRA6jvsMvFa2TPC8jax9sDf5GUCXUT9h-iqwu0VZDjZ/exec"
  },
  "secrets": {
    "required": ["GITHUB_TOKEN", "ERP_CLIENT_SECRET", "ADMIN_LOGIN_PASSWORD", "NAS_WATCHER_API_KEY", "DATABASE_BACKUP_API_KEY", "GMAIL_OAUTH_CLIENT_SECRET", "COIN_SERVICE_KEY"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DATABASE_COORDINATOR",
        "class_name": "DatabaseCoordinator"
      },
      {
        "name": "DUEL_ROOM",
        "class_name": "DuelRoom"
      },
      {
        "name": "HIDESEEK_ROOM",
        "class_name": "HideSeekRoom"
      },
      {
        "name": "MINIGAME_BOARD",
        "class_name": "MinigameBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DatabaseCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DuelRoom"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["HideSeekRoom"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["MinigameBoard"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
